{
    "importOrder": [
        "^svelte(/.*)?$",
        "^(?!(@/|\\.))(.*)$",
        "^@/validators/(.*)$",
        "^@/lib/(.*)$",
        "^@/components/(.*)$",
        "^./(.*).css$",
        "^./(.*)$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "plugins": [
        "@trivago/prettier-plugin-sort-imports",
        "prettier-plugin-svelte",
        "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app.css",
    "overrides": [
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
