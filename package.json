{
    "name": "fleet",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:server": "bun --watch server/index.ts",
        "build": "vite build",
        "start": "bun server/index.ts",
        "preview": "vite build && bun server/index.ts",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "type-check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "docker:build": "docker build -t fleet .",
        "docker:run": "docker run --rm -p 3000:3000 fleet"
    },
    "dependencies": {
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/bun": "^1.4.4",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-plugin-svelte": "^3.24.0",
        "globals": "^17.14.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.4",
        "typescript": "~6.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
